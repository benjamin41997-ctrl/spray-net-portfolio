# SERVER ONLY. Copy to .env; never commit the real file or prefix secrets with VITE_.
OPENAI_API_KEY=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
VISUALIZER_ACCESS_TOKEN=
# Separate private representative credential; required only for custom instructions.
VISUALIZER_OPERATOR_TOKEN=
# One-time tablet connection password, remembered on that tablet. Server secret only.
VISUALIZER_TABLET_PASSWORD=
VISUALIZER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://benjamin41997-ctrl.github.io
# Rolling limits across connected tablets. No daily cap. Failed attempts also count.
VISUALIZER_MAX_TEN_MINUTE_RENDERS=10
VISUALIZER_MAX_HOURLY_RENDERS=30
VISUALIZER_MIN_INTERVAL_SECONDS=5
VISUALIZER_TIMEOUT_SECONDS=240
# While true, customer previews use Flare/low. Authorized detail uses the detail model/high.
VISUALIZER_FAST_TEST_MODE=true
VISUALIZER_PREVIEW_MODEL=gpt-image-2.5-flare
VISUALIZER_DETAIL_MODEL=gpt-image-2.5-sunburst
VISUALIZER_USAGE_FILE=server/.local/usage.json
VISUALIZER_HOST=127.0.0.1
VISUALIZER_PORT=8787
